<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <!-- Tests do not publish AOT, so reflection-safety warnings from annotated library APIs are suppressed.
         Annotated APIs include: ProsodyClient.CreateAsync, ProsodyClientBuilder.BuildAsync,
         ProsodyClient.SendAsync<T> (convenience overload), ProsodyClient.SubscribeAsync<TPayload>
         (reflection overload), EventHandlerBridge<T> constructor, PermanentErrorResolver.GetAttribute,
         and ProsodyServiceCollectionExtensions.AddProsodyClient. -->
    <NoWarn>$(NoWarn);IL2026;IL3050</NoWarn>
  </PropertyGroup>

  <!-- Test framework -->
  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.0" />
  </ItemGroup>

  <!-- OpenTelemetry for integration test tracing verification -->
  <ItemGroup>
    <PackageReference Include="OpenTelemetry" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Api" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
  </ItemGroup>

  <!-- DI and Configuration for unit tests -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.9.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.11" />
  </ItemGroup>

  <!-- Code analyzers -->
  <ItemGroup Label="Analyzers">
    <PackageReference Include="Roslynator.Analyzers" Version="4.*" PrivateAssets="all" />
  </ItemGroup>

  <!-- Project reference for local development; package reference for CI package validation -->
  <ItemGroup Condition="'$(TestPackage)' != 'true'">
    <ProjectReference Include="..\..\src\Prosody\Prosody.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TestPackage)' == 'true'">
    <PackageReference Include="ProsodyEvents.Prosody" Version="$(TestPackageVersion)" />
  </ItemGroup>

  <!-- Keep the public README example compiling against both source and packaged APIs. -->
  <ItemGroup>
    <Compile Include="..\..\examples\keyed_state_windowing.cs" Link="Examples\keyed_state_windowing.cs" />
  </ItemGroup>

  <!-- Test configuration file to set xUnit test runner settings -->
  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
